# Maintainer: kumquat-omarchy (local install only — NOT for AUR upload)
# Local install only per user ruling: `makepkg -si` on this machine, no AUR.
pkgname=kumquat
pkgver=0.1.0
pkgrel=2
pkgdesc="Offline file-conversion wheel (275 conversions, 26 tools, 6 actions) for Omarchy/Arch"
arch=('any')
url="https://github.com/SulaimanBaeisa/kumquat-omarchy"
license=('MIT')
# The product was called tangerine-wheel before the rename; let pacman swap it.
replaces=('tangerine-wheel')
conflicts=('tangerine-wheel')
# GTK bindings and PyMuPDF are imported by the normal GUI/dispatcher path.
# GTK4 layer-shell is optional; ordinary toplevel windows are the default.
depends=('python>=3.11' 'gtk4>=4.12' 'python-gobject' 'ffmpeg'
         'imagemagick' 'libheif' 'libavif' 'poppler' 'qpdf'
         'python-pillow' 'python-pymupdf')
optdepends=('pandoc: document/EPUB conversion backend'
            'libreoffice-still: office and PDF conversion backend'
            '7zip: RAR/archive extraction backend'
            'exiftool: metadata backend'
            'wl-clipboard: Wayland clipboard actions'
            'localsend: the Share action opens your installed LocalSend app'
            'nautilus-python: selected-file keyboard and context-menu integration')
source=()
sha256sums=()

package() {
    # Sources live in the repo checkout (local install only, no tarball).
    local src="$startdir/.."
    install -d "$pkgdir/usr/lib/kumquat" "$pkgdir/usr/bin" \
        "$pkgdir/usr/share/applications"
    # Copy source only: bytecode caches embed local build paths and are private.
    tar -C "$src/src" --exclude='__pycache__' --exclude='*.py[co]' \
        -cf - kumquat | tar -C "$pkgdir/usr/lib/kumquat" -xf -
    # Run the package in-place; direct cli.py execution breaks relative imports.
    printf '%s\n' '#!/bin/sh' \
        "exec /usr/bin/python -c \"import sys; sys.path.insert(0, '/usr/lib/kumquat'); from kumquat.cli import main; raise SystemExit(main(sys.argv[1:]))\" \"\$@\"" \
        > "$pkgdir/usr/bin/kumquat"
    chmod +x "$pkgdir/usr/bin/kumquat"
    install -m644 "$src/packaging/kumquat.desktop" \
        "$pkgdir/usr/share/applications/"
    install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
