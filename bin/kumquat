#!/bin/sh
# Starts Kumquat from this plugin checkout. Arguments are passed to `kumquat`
# unchanged (see `bin/kumquat --help`).
#
# Kumquat needs GTK 4 through PyGObject, which the system Python provides. A
# virtualenv does not. Set KUMQUAT_PYTHON to use another interpreter, for
# example one with the development requirements installed.
set -eu

self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
here=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd -P)

python=${KUMQUAT_PYTHON:-/usr/bin/python3}
if [ ! -x "$python" ]; then
    python=$(command -v python3 2>/dev/null) || {
        echo "kumquat: python3 was not found; install the python package" >&2
        exit 127
    }
fi

# Keep compiled bytecode out of the plugin folder. The shell reloads a plugin when a
# file under it changes, and `omarchy plugin update` expects a clean git checkout.
PYTHONPYCACHEPREFIX=${PYTHONPYCACHEPREFIX:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/kumquat/pycache}
export PYTHONPYCACHEPREFIX

# The source directory travels as an argument, never inside the program text, so
# no path can be misread as code.
exec "$python" -c '
import sys
sys.path.insert(0, sys.argv.pop(1))
from kumquat.cli import main
raise SystemExit(main(sys.argv[1:]))
' "$here/src" "$@"
