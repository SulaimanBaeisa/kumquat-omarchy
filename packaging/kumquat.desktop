[Desktop Entry]
Type=Application
Name=Kumquat
Comment=Offline file-conversion wheel (275 conversions, 26 tools, 6 actions)
Exec=sh -c "if [ \\$# -gt 0 ]; then set -- --files \\"\\$@\\"; fi; exec kumquat --gui \\"\\$@\\"" kumquat %F
Icon=kumquat
Terminal=false
Categories=Utility;FileTools;
MimeType=image/jpeg;image/png;image/webp;image/heic;image/heif;image/tiff;image/svg+xml;image/avif;image/bmp;image/gif;video/mp4;video/quicktime;video/x-matroska;video/webm;video/x-msvideo;video/x-ms-wmv;audio/mpeg;audio/mp4;audio/x-wav;audio/flac;audio/ogg;audio/opus;audio/x-aiff;audio/x-ms-wma;application/pdf;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/msword;text/markdown;text/rtf;text/plain;text/html;application/epub+zip;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel;text/csv;text/tab-separated-values;application/vnd.oasis.opendocument.spreadsheet;application/vnd.ms-powerpoint;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/x-subrip;text/vtt;application/zip;application/x-tar;application/gzip;application/x-rar;
StartupNotify=true
StartupWMClass=dev.kumquat.app
